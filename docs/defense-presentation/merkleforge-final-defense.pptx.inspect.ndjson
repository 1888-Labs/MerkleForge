{"kind":"textbox","id":"sh/udwnu5of","slide":6,"text":"Binary Merkle Tree","textPreview":"Binary Merkle Tree","textChars":18,"textLines":1,"bbox":[126,286,584,28]}
{"kind":"textbox","id":"sh/hgnmpk76","slide":6,"text":"Best for ordered lists such as transactions, files, logs, and block batches.","textPreview":"Best for ordered lists such as transactions, files, logs, and block batches.","textChars":76,"textLines":1,"bbox":[126,316,584,44]}
{"kind":"shape","id":"sh/gfe5wf6l","slide":6,"bbox":[100,386,10,10]}
